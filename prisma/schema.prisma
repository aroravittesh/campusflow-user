generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // change if you're using MySQL/SQLite
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
}
